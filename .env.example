# PostgreSQL connection string (Docker Compose default below)
DATABASE_URL="postgresql://shop:shop@localhost:5432/telegram_shop?schema=public"

# Telegram bot token from @BotFather
BOT_TOKEN=""

# Public URL of this app (used by the bot Mini App button)
APP_URL="http://localhost:3000"

# Optional secret Telegram sends as x-telegram-bot-api-secret-token
WEBHOOK_SECRET=""

# Admin dashboard password
ADMIN_PASSWORD="changeme"

# Random string used to sign the admin session cookie
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"

# Optional comma-separated Telegram user IDs allowed as admin
ADMIN_TELEGRAM_IDS=""

# Throwaway bot token used only to sign mock initData on localhost.
# Create a second bot in BotFather for this — never reuse production BOT_TOKEN.
DEV_BOT_TOKEN="123456:DEV-LOCAL-MOCK-TOKEN"
NEXT_PUBLIC_DEV_BOT_TOKEN="123456:DEV-LOCAL-MOCK-TOKEN"
